[rendering]

renderer/rendering_method="forward_plus"
; --- 2 GB VRAM budget: these are guards, not preferences -------------------
; MSAA 2x. 2 (4x) and 3 (8x) are banned by the project budget; scripts/main.gd
; fails loudly at startup if this is raised.
anti_aliasing/quality/msaa_3d=1
; SSAO at Low. Radius/intensity live on the Environment in scenes/main.tscn.
environment/ssao/quality=1
; Two shadow splits at max_distance 60 do not need a 4096 atlas; 2048 halves the
; largest single VRAM allocation in the scene (~64 MB -> ~16 MB).
lights_and_shadows/directional_shadow/size=2048
